<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MosqueOS.Application\MosqueOS.Application.csproj" />
    <ProjectReference Include="..\MosqueOS.Domain\MosqueOS.Domain.csproj" />
    <ProjectReference Include="..\MosqueOS.Infrastructure\MosqueOS.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\scripts\mos_db_tsql.sql" Link="Database\mos_db_tsql.sql" />
    <None Include="..\scripts\README.txt" Link="Database\README.txt" />
  </ItemGroup>

</Project>
